# Copy to .env.local and fill in what you have. WeekendGuard runs with
# real, non-mocked BSC data (DexScreener, on-chain balances) even with
# NONE of these set — see src/lib/providers/* for exactly what degrades
# (clearly labelled, never silently faked) when a key is missing.

# Required for any live independent reference price (Chainlink/Pyth
# equity feeds via Pyth Hermes). Without it, referencePrice/priceFreshness/
# referenceDeviation checks report "unavailable", not a fabricated number.
# Sign up: https://pyth.network (Pyth Terminal free trial) — required since
# the Aug 26 2026 "Pyth Core" upgrade (see src/lib/providers/pyth.ts).
PYTH_API_KEY=

# Optional: your own BSC RPC endpoint. Defaults to Binance's public
# bsc-dataseed.binance.org, which is fine for a hackathon demo but can be
# rate-limited under load.
BSC_RPC_URL=

# Binance Web3 Developer Portal credentials (web3.binance.com/en/dev-portal —
# NOT the regular binance.com Exchange "API Management" page; an Exchange
# API key will authenticate to a different host entirely and 401 here).
# Required for src/lib/providers/binanceRwa.ts (RWA Data API: platforms,
# search, tokens, price, underlying-market, underlying-profile).
# SERVER-SIDE ONLY — never reference these in client-side code; see the
# guard at the top of binanceRwa.ts. Reaching web3.binance.com may require
# a VPN depending on your network/region (observed during this build).
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET=

# Optional: where the Protection Monitoring Session SQLite database lives
# (src/lib/protection/db.ts). Defaults to ./data/weekendguard.sqlite,
# created automatically on first run — no manual setup needed. Set to a
# different path if you want the file elsewhere; `npm test` always uses
# ":memory:" regardless of this (see .env.test), never your real data file.
WEEKENDGUARD_DB_PATH=

# Shared secret required to trigger GET/POST /api/protection-scheduler
# (src/app/api/protection-scheduler/route.ts — the endpoint meant to be
# wired to a real external cron once this is deployed somewhere). Accepted
# as either `Authorization: Bearer <secret>` or `?secret=<secret>`.
# Left unset in development (`next dev`): the endpoint accepts any request,
# for local/demo convenience.
# Left unset in production (`next start`, i.e. a real deployment): the
# endpoint FAILS CLOSED (503) rather than stay open to the public internet —
# see DEPLOYMENT.md section 5. REQUIRED before any public deployment.
# Generate with: openssl rand -hex 32
SCHEDULER_TRIGGER_SECRET=

# --- Settlement contract (contracts/src/WeekendGuardSettlement.sol) ---
# See SETTLEMENT.md for the full architecture. NOT deployed as part of this
# task — these are all empty until you deploy the contract yourself
# (testnet recommended; see contracts/hardhat.config.ts).

# SERVER-ONLY SECRET. The "trusted signer" EOA's private key — the backend
# signs EIP-712 settlement authorizations with this key; the deployed
# contract's `trustedSigner` must be set to the matching address via
# setTrustedSigner(). TESTNET-ONLY for this task — never put a mainnet key
# with real value here. Generate a throwaway key, e.g. via `cast wallet new`
# (Foundry) or any wallet's "create new account" flow.
SETTLEMENT_SIGNER_PRIVATE_KEY=

# Shared secret required to call POST /api/dev/settlement-authorization
# (src/app/api/dev/settlement-authorization/route.ts). Deliberately SEPARATE
# from SCHEDULER_TRIGGER_SECRET — signing a settlement authorization is a
# more sensitive privilege than triggering a monitoring check, so the two
# are never bundled under one secret. Accepted as either
# `Authorization: Bearer <secret>` or `?secret=<secret>`.
# Left unset in development (`next dev`): open, for local/demo convenience.
# Left unset in production (`next start`): FAILS CLOSED (503) rather than
# leave this reachable with no authentication — see
# reports/Settlement audit and deployment readiness.md section E/L for why
# this route in particular must never be left open. REQUIRED before any
# public deployment. Generate with: openssl rand -hex 32
SETTLEMENT_AUTHORIZATION_SECRET=

# Public (safe for the browser — on-chain addresses, not secrets). The
# deployed WeekendGuardSettlement address and the USDT token address it
# uses as its reserve asset (NOT USDC — see SETTLEMENT.md "reserve asset"
# for why BRIX's settlement reserve is USDT, unifying the economic flow
# with the USDT already supported as a spot-purchase quote asset), plus
# which chain to target (97 = BSC testnet, the default if unset; 56 = BSC
# mainnet — only set this once you actually intend a mainnet demo, see
# SETTLEMENT.md "deployment status").
NEXT_PUBLIC_SETTLEMENT_CONTRACT_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_CHAIN_ID=97

# --- AI Investment Assistant (src/lib/invest/assistant/) ---
# Optional. SERVER-ONLY SECRET — never sent to the client. Without it, the
# assistant still works fully: it answers using a deterministic template
# built from the same live data (see assistantActions.ts) — only the
# natural-language PHRASING of replies is enhanced when this is set; the
# underlying facts/numbers are identical either way (the model never
# computes a price/quote itself, see llmClient.ts). Get a key at
# https://console.anthropic.com if you want the richer phrasing.
ANTHROPIC_API_KEY=
